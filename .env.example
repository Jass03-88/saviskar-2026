# ==============================================================================
# SAVISKAR 2026 — ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy this file to .env.local (or .env.development.local) and fill in your values.
# ==============================================================================

# Site URL & Payment Callback Base Origin
# Local: http://localhost:3000
# Production: https://saviskar-26.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PAYMENT_CALLBACK_BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase Configuration
# Dashboard: https://supabase.com/dashboard/project/<project-id>/settings/api
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# ------------------------------------------------------------------------------
# Resend Email Service
# Dashboard: https://resend.com/api-keys
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL="Saviskar 2026 <noreply@yourdomain.com>"

# ------------------------------------------------------------------------------
# PayU Payment Gateway
# Dashboard: https://dashboard.payu.in/
# ------------------------------------------------------------------------------
PAYU_ENVIRONMENT=test
PAYU_KEY=your_test_key
PAYU_SALT=your_test_salt
PAYMENT_GATEWAY=payu

# ------------------------------------------------------------------------------
# Admin & Security Overrides (Optional / Production Required)
# ------------------------------------------------------------------------------
PRIMARY_ADMIN_EMAIL=admin@yourdomain.com
# PRIMARY_ADMIN_USER_ID=
# PAYMENT_RESUME_TOKEN_SECRET=

# Admin Session Expiration Lifetime in seconds (Default: 28800 = 8 hours)
# Enforced server-side for all admin dashboard routes, middleware, and API handlers.
ADMIN_SESSION_MAX_AGE_SECONDS=28800

# Registration Authentication Session Secret (High entropy server-only secret, e.g. openssl rand -hex 32)
# Required in production; application authentication will fail closed if missing.
# NEVER expose to client bundles or NEXT_PUBLIC_* variables.
SESSION_SECRET=your_32_byte_session_secret

# ------------------------------------------------------------------------------
# External Google Drive Gallery Links
# Paste public Google Drive folder URLs or direct file sharing links:
# ------------------------------------------------------------------------------
NEXT_PUBLIC_MAIN_GALLERY_GDRIVE_URL="https://drive.google.com/drive/folders/1sKBgnkvnwO53Wvcg_m26MfOQidN3szL9?usp=share_link"
NEXT_PUBLIC_GLIMPSE_GALLERY_GDRIVE_URL="https://drive.google.com/drive/folders/1eIpgYcrOpKOfBvw-FsbQ8-vAn-ysqomb?usp=sharing"
